modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-sync"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-web"

[[workflows.workflow]]
name = "typecheck-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/irrigbucket-mobile run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build-web"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BASE_PATH=/ PORT=5000 pnpm --filter @workspace/irrigbucket run build"

[[workflows.workflow]]
name = "test-sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/sync run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/irrigbucket run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[objectStorage]
defaultBucketID = "replit-objstore-3dff5f3e-5bc6-4b37-8118-45ace243c9df"

[nix]
channel = "stable-25_05"
packages = ["eas-cli", "killall"]

[userenv]

[userenv.shared]
SUPABASE_URL = "https://szlukdnwkmnwlkfritpl.supabase.co"
ADMIN_USER_ID = "1c887cbd-bc8a-4f0c-833f-5e5fdb20d148"
